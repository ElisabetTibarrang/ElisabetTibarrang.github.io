---
// src/pages/blog/page/[page].astro
import type {
  GetStaticPaths,
  InferGetStaticPropsType,
  Page,
} from "astro";
import type { CollectionEntry } from "astro:content";

import ArticleLayout from "@/layouts/ArticleLayout.astro";
import BlogCard from "@/components/BlogCard.astro";
import Pagination from "@/components/Pagination.astro";

import { getVisibleCollection } from "@/utils/collections.mjs";
import { collections } from "@/config/pages.mjs";
import type { HeadProps } from "@/types/HeadProps";

type BlogEntry = CollectionEntry<"blog">;

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  const cfg = collections.blog;
  const entries = (await getVisibleCollection("blog")) as BlogEntry[];
  const pageSize = cfg.pagination?.pageSize || 12;

  const paths = paginate(entries, {
    pageSize,
  });

  return paths.filter((path) => Number(path.params.page) > 1);
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props & {
  page: Page<BlogEntry>;
};

const cfg = collections.blog;

const headProps: HeadProps = {
  title: `${cfg.title} - Page ${page.currentPage}`,
  description: cfg.description,
  canonicalUrl: `/blog/page/${page.currentPage}/`,
  type: "collection",
  index: true,
};
---

<ArticleLayout headProps={headProps}>
  <section class="collection-page max-w-content mi-auto p-1">
    <h1>{cfg.title}</h1>
    <p>Page {page.currentPage}</p>

    <div class="grid gap my-2" data-card-collections>
      {page.data.map((entry) => (
        <BlogCard entry={entry} collectionKey="blog" />
      ))}
    </div>

    <Pagination page={page} />
  </section>
</ArticleLayout>