---
import Anchor from "@components/ui/Anchor.astro";
import SvgIcon from "@components/svg/SvgIcon.astro";
---

<Anchor
  href="/search/"
  title="Search"
  ariaLabel="Search"
  className="search-button inline-flex ai-center jc-center h-2-0 w-2-0 no-bb p-02 br-r hover-bg-primary-lighter"
>
  <SvgIcon name="search" className="w-1-5 h-1-5" />
  <span class="sr-only">Search</span>
</Anchor>