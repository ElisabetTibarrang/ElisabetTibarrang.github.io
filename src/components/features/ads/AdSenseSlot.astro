---
// src/components/features/ads/AdSenseSlot.astro

/**
 * Usage examples:
    <AdSenseSlot slotId="1234567890" />
    <AdSenseSlot
      slotId="1234567890"
      width="md"
      ratio="16-9"
    />
    <AdSenseSlot
      slotId="1234567890"
      width="sm"
      ratio="1-1"
    />
    <AdSenseSlot
      slotId="1234567890"
      width="lg"
      ratio="4-3"
      containerClass="my-2 flex jc-center"
    />
 */

import adsConfig from "@/config/ads.mjs";

type Width =
  | "auto"
  | "full"
  | "xs"
  | "sm"
  | "md"
  | "lg"
  | "xl";

type Ratio =
  | "none"
  | "1-1"
  | "4-3"
  | "3-2"
  | "16-9"
  | "5-1"
  | "6-1";

interface Props {
  slotId: string;

  /** Optional override */
  clientId?: string;

  /** auto | fluid | rectangle ... */
  format?: string;

  /** width utility */
  width?: Width;

  /** aspect-ratio utility */
  ratio?: Ratio;

  /** class on <ins> */
  class?: string;
  className?: string;

  /** class on wrapper */
  containerClass?: string;
}

const {
  slotId,

  clientId,
  format = "auto",

  width = "full",
  ratio = "none",

  class: classAttr = "",
  className = "",

  containerClass = "flex jc-center overflow-hidden",
} = Astro.props as Props;

const resolvedClientId = String(
  clientId || adsConfig.adsenseClientId || "",
).trim();

const enabled =
  adsConfig.enabled &&
  resolvedClientId &&
  slotId;

const widthClassMap: Record<Width, string> = {
  auto: "w-auto",
  full: "w-full",

  xs: "w-240px sm-w-full",
  sm: "w-320px sm-w-full",
  md: "w-420px sm-w-full",
  lg: "w-600px sm-w-full",
  xl: "w-720px sm-w-full",
};

const ratioClassMap: Record<Ratio, string> = {
  none: "",

  "1-1": "ar-1-1",
  "4-3": "ar-4-3",
  "3-2": "ar-3-2",
  "16-9": "ar-16-9",

  "5-1": "ar-5-1",
  "6-1": "ar-6-1",
};

const insClass = [
  "adsbygoogle",
  widthClassMap[width],
  ratioClassMap[ratio],
  classAttr,
  className,
]
  .filter(Boolean)
  .join(" ");
---

{
  enabled && (
    <div class={containerClass}>
      <ins
        class={insClass}
        data-ad-client={resolvedClientId}
        data-ad-slot={slotId}
        data-ad-format={format}
        data-full-width-responsive="true"
      ></ins>
    </div>
  )
}