---
// src/components/ui/Anchor.astro
import type { UiVariant } from "./types";

interface Props {
  href: string;
  class?: string;
  className?: string;
  target?: "_blank" | "_self";
  rel?: string;
  ariaLabel?: string;
  title?: string;
  type?: "link" | "button";
  variant?: UiVariant;
  dataId?: string;
  dataAction?: string;
  dataLabel?: string;
  dataTargets?: string;
  role?: string;
  itemprop?: string;
}

const {
  href,
  class: classAttr = "",
  className = "",
  target,
  rel,
  ariaLabel,
  title,
  type,
  variant = "plain",
  dataId,
  dataAction,
  dataLabel,
  dataTargets,
  role,
  itemprop,
  ...rest
} = Astro.props as Props & Record<string, unknown>;

const siteOrigin = Astro.site?.origin || "http://localhost";

let resolvedHref: URL;

try {
  resolvedHref = new URL(href, siteOrigin);
} catch {
  resolvedHref = new URL("/", siteOrigin);
}

const isExternal = resolvedHref.origin !== siteOrigin;
const finalTarget = target || (isExternal ? "_blank" : undefined);
const finalRel =
  rel ||
  (isExternal && finalTarget === "_blank" ? "noopener noreferrer" : undefined);

const variantClassMap: Record<string, string> = {
  plain: "",
  nav: "no-bb br-r",
  ghost: "button bg-transparent col-inherit hover-bg-base-10",
  primary: "button primary-button",
  secondary: "button secondary-button",
};

const buttonLikeVariants = ["ghost", "primary", "secondary"];
const isButtonLike = type === "button" || buttonLikeVariants.includes(variant);

const allowedVariant =
  variant in variantClassMap ? variant : "plain";

const computedClass = [
  variantClassMap[allowedVariant],
  classAttr,
  className,
]
  .filter(Boolean)
  .join(" ");

const defaultAction = isButtonLike
  ? "button_click"
  : isExternal
    ? "outbound_click"
    : "link_click";

const computedRole = role || (isButtonLike ? "button" : undefined);
---

<a
  href={href}
  target={finalTarget}
  rel={finalRel}
  class={computedClass}
  aria-label={ariaLabel}
  title={title}
  role={computedRole as "button" | undefined}
  itemprop={itemprop}
  data-id={dataId}
  data-action={dataAction || defaultAction}
  data-label={dataLabel}
  data-targets={dataTargets}
  {...rest}
>
  <slot name="icon-left" />
  <slot />
  <slot name="icon-right" />
</a>