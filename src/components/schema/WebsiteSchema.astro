---
import brandConfig from "@/config/brand.mjs";
import JsonLd from "./JsonLd.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${brandConfig.siteUrl}#website`,
  name: brandConfig.siteName,
  alternateName: brandConfig.shortName,
  url: brandConfig.siteUrl,
  description: brandConfig.description,
  inLanguage: brandConfig.lang || "en",
  publisher: {
    "@id": `${brandConfig.siteUrl}#organization`,
  },
};
---

<JsonLd id="website-schema" data={schema} />