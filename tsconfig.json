{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*",
    "./worker-configuration.d.ts"
  ],
  "exclude": [
    "dist",
    ".wrangler",
    "node_modules"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "strictNullChecks": true,
    "types": [
      "astro/client",
      "@cloudflare/workers-types",
      "node"
    ],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./src/*"],
      "src/*": ["./src/*"],
      "core/*": ["./core/*"],
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@assets/*": ["./src/assets/*"],
      "@styles/*": ["./src/styles/*"],
      "@config/*": ["./src/config/*"],
      "@data/*": ["./src/data/*"],
      "@lib/*": ["./src/lib/*"],
      "@utils/*": ["./src/utils/*"],
      "@system/*": ["./src/components/system/*"],
      "@ui/*": ["./src/components/ui/*"]
    }
  }
}